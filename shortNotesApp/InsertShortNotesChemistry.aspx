<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="InsertShortNotesChemistry.aspx.cs" Inherits="shortNotesApp.InsertShortNotesChemistry" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Insert Short Notes Chemistry</title>
    <link href="/Content/jquery.mobile-1.4.5.css" rel="stylesheet" />
    <script type="text/javascript" src="/Scripts/jquery-1.8.0.js"></script>
    <script type="text/javascript" src="/Scripts/jquery.mobile-1.4.5.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        iframe[src*="somee.com"],
        script[src*="somee.com"],
        a[href*="somee.com"],
        div[style*="z-index"] {
            display: none !important;
            visibility: hidden !important;
        }
    </style>
    <style>
        td {
            padding: 10px;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        .half-height {
            height: 100vh; /* 50% of the viewport height */
            box-sizing: border-box;
            padding: 1em;
        }

        .scroll-container {
            overflow-x: auto;
            width: 100%;
        }

            .scroll-container table {
                width: 100%;
                /*  min-height:600px; */ /* makes sure scroll appears on small screens */
            }
    </style>
</head>
<body>
    <form id="form1" runat="server" data-ajax="false">
        <div data-role="page" data-theme="b">
            <div data-role="header">
                Insert Chemistry
            </div>
            <div data-role="content">
                <asp:SqlDataSource ID="sourceShortNotes" runat="server" ProviderName="System.Data.SqlClient" ConnectionString="<%$ ConnectionStrings:Northwind %>" SelectCommand="SELECT * FROM ShortNotesChemistry" UpdateCommand="UPDATE ShortNotesChemistry SET Title=@Title,LessonNo=@LessonNo,Link=@Link,Optional1=@Optional1,Optional2=@Optional2,Optional3=@Optional3 WHERE Id=@Id" DeleteCommand="DELETE ShortNotesChemistry WHERE Id=@Id" InsertCommand="INSERT INTO ShortNotesChemistry (Title,LessonNo,Link,Optional1,Optional2,Optional3) VALUES (@Title,@LessonNo,@Link,@Optional1,@Optional2,@Optional3)" OnUpdated="sourceShortNotes_Updated" OnInserted="sourceShortNotes_Inserted" OnDeleted="sourceShortNotes_Deleted" OnSelected="sourceShortNotes_Selected" OnDeleting="sourceShortNotes_Deleting"></asp:SqlDataSource>
                <asp:Panel runat="server" ID="pnlPwd">
                    UserName : 
                    <asp:TextBox runat="server" ID="txtUName"></asp:TextBox>
                    Password : 
                    <asp:TextBox runat="server" ID="txtPwd" TextMode="Password"></asp:TextBox>
                    <asp:Button runat="server" ID="btnSubmit" Text="Submit" OnClick="btnSubmit_Click" />
                    <asp:Label runat="server" ID="lblInfo"></asp:Label>
                </asp:Panel>
                <asp:Panel runat="server" ID="pnlContent">
                    <div class="scroll-container half-height">
                        <asp:Label runat="server" ID="lblInfo1"></asp:Label>
                        <asp:DetailsView runat="server" ID="dtlView" CssClass="ui-responsive table-stroke" DataKeyNames="Id" AllowPaging="true" DataSourceID="sourceShortNotes" AutoGenerateEditButton="true" AutoGenerateDeleteButton="true" AutoGenerateInsertButton="true">
                            <PagerSettings PageButtonCount="10" />
                        </asp:DetailsView>
                    </div>
                </asp:Panel>
            </div>
        </div>
    </form>

    <!--script to remove ads-->
    <script>
        window.onload = function () {
            // Remove all scripts containing "somee.com"
            document.querySelectorAll("script").forEach(script => {
                if (script.src.includes("somee.com") || script.innerHTML.includes("somee.com")) {
                    script.remove();
                }
            });

            // Remove the "Web hosting by Somee.com" banner
            document.querySelectorAll("a[href='http://somee.com']").forEach(link => {
                link.parentElement.remove();
            });

            // Remove injected comments
            document.body.childNodes.forEach(node => {
                if (node.nodeType === Node.COMMENT_NODE && node.nodeValue.includes("SCRIPT GENERATED BY SERVER")) {
                    node.remove();
                }
            });
        };
    </script>

</body>
</html>
